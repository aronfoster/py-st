[Unit]
Description=py-st authoritative worker (requires explicit arming)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/py-st
ConditionPathIsMountPoint=/srv/py-st
ConditionPathExists=/etc/py-st/worker-armed
ConditionPathExists=!/srv/py-st/HANDOFF_REQUIRED

[Service]
Type=simple
User=py-st
Group=py-st
WorkingDirectory=/srv/py-st
Environment=ST_STATE_ROOT=/srv/py-st
ExecStart=/opt/py-st/current/.venv/bin/python -m py_st flight worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/py-st
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
